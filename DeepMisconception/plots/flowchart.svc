<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1380" width="1000" height="1380">
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 1 L 10 5 L 0 9 z" fill="#000000"/>
    </marker>
    <style>
      .bg { fill: #ffffff; }
      .box { fill: #ffffff; stroke: #000000; stroke-width: 1.5; }
      .box-bold { fill: #ffffff; stroke: #000000; stroke-width: 2.2; }
      .box-dashed { fill: #ffffff; stroke: #000000; stroke-width: 1.5; stroke-dasharray: 4,4; }
      .stage-box { fill: #ffffff; stroke: #000000; stroke-width: 1.5; stroke-dasharray: 6,4; }
      .line { stroke: #000000; stroke-width: 1.5; fill: none; }
      .line-bold { stroke: #000000; stroke-width: 2; fill: none; }
      .text-title { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 15px; font-weight: bold; fill: #000000; text-anchor: middle; }
      .text-stage { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 12px; font-weight: bold; fill: #000000; letter-spacing: 0.5px; }
      .text-body { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 12px; fill: #000000; text-anchor: middle; }
      .text-sub { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 11px; fill: #000000; text-anchor: middle; }
      .text-small { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 10px; fill: #000000; text-anchor: middle; }
    </style>
  </defs>

  <!-- Background Canvas: Pure White -->
  <rect class="bg" width="1000" height="1380"/>

  <!-- ==================== STAGE 1: MULTIMODAL INPUT & SYNTHESIS ==================== -->
  <rect class="stage-box" x="40" y="25" width="920" height="175" rx="6"/>
  <text class="text-stage" x="55" y="45">PHASE 1: MULTIMODAL DATA INPUT &amp; REPRESENTATION</text>

  <!-- Stream 1: Code -->
  <rect class="box-bold" x="65" y="60" width="265" height="120" rx="4"/>
  <text class="text-title" x="197" y="85">Source Code Modality</text>
  <line class="line" x1="85" y1="95" x2="310" y2="95"/>
  <text class="text-body" x="197" y="115">• Python AST Syntax Tree</text>
  <text class="text-sub" x="197" y="133">16 Structural Metrics (Complexity, Depth)</text>
  <text class="text-body" x="197" y="153">• Pretrained CodeBERT Backbone</text>
  <text class="text-sub" x="197" y="169">Contextual Token Embedding (768-D)</text>

  <!-- Stream 2: Viva -->
  <rect class="box-bold" x="367" y="60" width="265" height="120" rx="4"/>
  <text class="text-title" x="500" y="85">Oral Viva Voce Modality</text>
  <line class="line" x1="387" y1="95" x2="612" y2="95"/>
  <text class="text-body" x="500" y="115">• Dynamic Code-Grounded Q&amp;A</text>
  <text class="text-sub" x="500" y="133">Probing Invariants &amp; Execution States</text>
  <text class="text-body" x="500" y="153">• Pretrained Sentence-BERT</text>
  <text class="text-sub" x="500" y="169">Frozen Semantic Embedding (384-D)</text>

  <!-- Stream 3: Process -->
  <rect class="box-bold" x="670" y="60" width="265" height="120" rx="4"/>
  <text class="text-title" x="802" y="85">Process Telemetry Modality</text>
  <line class="line" x1="690" y1="95" x2="915" y2="95"/>
  <text class="text-body" x="802" y="115">• Chronological Keystroke Streams</text>
  <text class="text-sub" x="802" y="133">128-Step Action Sequence Modeling</text>
  <text class="text-body" x="802" y="153">• Process Transformer (64-D)</text>
  <text class="text-sub" x="802" y="169">+ 24 Z-Score Normalized Features</text>

  <!-- Flow Arrows Stage 1 -> Stage 2 -->
  <line class="line-bold" x1="197" y1="180" x2="197" y2="230" marker-end="url(#arrow)"/>
  <line class="line-bold" x1="500" y1="180" x2="500" y2="230" marker-end="url(#arrow)"/>
  <line class="line-bold" x1="802" y1="180" x2="802" y2="230" marker-end="url(#arrow)"/>

  <!-- ==================== STAGE 2: EVIDENCE GATING & PRE-PROCESSING ==================== -->
  <rect class="stage-box" x="40" y="235" width="920" height="135" rx="6"/>
  <text class="text-stage" x="55" y="255">PHASE 2: EVIDENCE STATUS FILTERING &amp; PRE-PROCESSING</text>

  <!-- Decision Gate: Viva Verification -->
  <polygon points="500,265 600,305 500,345 400,305" class="box-bold"/>
  <text class="text-title" x="500" y="303" style="font-size:12px;">Oral Viva</text>
  <text class="text-title" x="500" y="317" style="font-size:12px;">Evidence Valid?</text>

  <!-- Yes -> Flow Down -->
  <line class="line-bold" x1="500" y1="345" x2="500" y2="395" marker-end="url(#arrow)"/>
  <text class="text-sub" x="520" y="365" style="font-weight:bold;">YES</text>

  <!-- No -> Side Box: Gated -->
  <line class="line-bold" x1="600" y1="305" x2="685" y2="305" marker-end="url(#arrow)"/>
  <text class="text-sub" x="635" y="297" style="font-weight:bold;">NO (Empty/Evasive)</text>

  <rect class="box-dashed" x="685" y="275" width="250" height="60" rx="4"/>
  <text class="text-title" x="810" y="298" style="font-size:13px;">Status Gate Activated</text>
  <text class="text-sub" x="810" y="318">Pending / Insufficient Evidence</text>
  <text class="text-small" x="810" y="330">(Routed to Human Instructor Review)</text>

  <!-- Left Side: Code Preprocessing pass-through -->
  <rect class="box" x="65" y="280" width="265" height="55" rx="4"/>
  <text class="text-body" x="197" y="303" style="font-weight:bold;">Code Tokenization &amp; AST</text>
  <text class="text-sub" x="197" y="322">Fixed Input Length &amp; Attention Masks</text>
  <line class="line-bold" x1="197" y1="335" x2="197" y2="395" marker-end="url(#arrow)"/>

  <!-- Right Side: Process Preprocessing pass-through -->
  <line class="line-bold" x1="802" y1="230" x2="802" y2="395" marker-end="url(#arrow)"/>

  <!-- ==================== STAGE 3: STAGE A CROSS-MODAL ALIGNMENT ==================== -->
  <rect class="stage-box" x="40" y="400" width="920" height="200" rx="6"/>
  <text class="text-stage" x="55" y="420">PHASE 3: STAGE A - CROSS-MODAL LATENT CONTRASTIVE ALIGNMENT</text>

  <!-- Projections -->
  <rect class="box" x="65" y="435" width="265" height="60" rx="4"/>
  <text class="text-title" x="197" y="458">Linear Projection W_code</text>
  <text class="text-sub" x="197" y="478">768-D &rarr; 128-D + LayerNorm</text>

  <rect class="box" x="367" y="435" width="265" height="60" rx="4"/>
  <text class="text-title" x="500" y="458">Linear Projection W_viva</text>
  <text class="text-sub" x="500" y="478">384-D &rarr; 128-D + LayerNorm</text>

  <rect class="box" x="670" y="435" width="265" height="60" rx="4"/>
  <text class="text-title" x="802" y="458">Linear Projection W_proc</text>
  <text class="text-sub" x="802" y="478">64-D &rarr; 128-D + LayerNorm</text>

  <!-- Lines converging to Alignment Loss -->
  <line class="line" x1="197" y1="495" x2="380" y2="530" marker-end="url(#arrow)"/>
  <line class="line" x1="500" y1="495" x2="500" y2="525" marker-end="url(#arrow)"/>
  <line class="line" x1="802" y1="495" x2="620" y2="530" marker-end="url(#arrow)"/>

  <!-- Loss Box -->
  <rect class="box-bold" x="250" y="525" width="500" height="60" rx="4"/>
  <text class="text-title" x="500" y="547">Symmetric InfoNCE Contrastive &amp; Cosine Loss</text>
  <text class="text-sub" x="500" y="568">L_align = InfoNCE(z_c, z_v) + &lambda;_1 InfoNCE(z_c, z_p) + &lambda;_2 Cosine(z_v, z_p)</text>

  <!-- Arrow to Stage 4 -->
  <line class="line-bold" x1="500" y1="585" x2="500" y2="625" marker-end="url(#arrow)"/>

  <!-- ==================== STAGE 4: MULTIMODAL FUSION TRANSFORMER ==================== -->
  <rect class="stage-box" x="40" y="630" width="920" height="275" rx="6"/>
  <text class="text-stage" x="55" y="650">PHASE 4: STAGE B - MULTIMODAL FUSION TRANSFORMER</text>

  <!-- Token Assembly -->
  <rect class="box" x="180" y="665" width="640" height="45" rx="4"/>
  <text class="text-title" x="500" y="693">Multimodal Sequence: H_0 = [ z_code + e_c ; z_viva + e_v ; z_proc + e_p ] &isin; R^(3 &times; 128)</text>

  <line class="line-bold" x1="500" y1="710" x2="500" y2="735" marker-end="url(#arrow)"/>

  <!-- Transformer Layers Stack -->
  <rect class="box-bold" x="180" y="735" width="640" height="95" rx="4"/>
  <text class="text-title" x="500" y="760">4-Layer Bidirectional Transformer Encoder</text>
  <line class="line" x1="200" y1="770" x2="800" y2="770"/>
  <text class="text-body" x="500" y="790">• 8 Multi-Head Self-Attention Heads (d_k = 16) | Cross-Modal Token Self-Attention</text>
  <text class="text-sub" x="500" y="812">• Feedforward Dimension = 512 | LayerNorm &amp; Residual Connections | Dropout = 0.1</text>

  <line class="line-bold" x1="500" y1="830" x2="500" y2="855" marker-end="url(#arrow)"/>

  <!-- Pooling -->
  <rect class="box" x="270" y="855" width="460" height="35" rx="4"/>
  <text class="text-body" x="500" y="877" style="font-weight:bold;">Sequence Mean Pooling: z_fused = Mean(H_4, axis=tokens) &isin; R^128</text>

  <line class="line-bold" x1="500" y1="890" x2="500" y2="930" marker-end="url(#arrow)"/>

  <!-- ==================== STAGE 5: CLASSIFICATION & PEDAGOGICAL DECISION ==================== -->
  <rect class="stage-box" x="40" y="935" width="920" height="225" rx="6"/>
  <text class="text-stage" x="55" y="955">PHASE 5: STAGE C - CLASSIFICATION HEAD &amp; PEDAGOGICAL DIAGNOSIS</text>

  <!-- Classification Dense Layer -->
  <rect class="box" x="270" y="970" width="460" height="45" rx="4"/>
  <text class="text-title" x="500" y="995">Linear Classification Head + GELU + Dropout(0.1)</text>
  <text class="text-sub" x="500" y="1009">y_hat = Softmax( W_2 &middot; GELU(LayerNorm(W_1 &middot; z_fused + b_1)) + b_2 )</text>

  <!-- Split into 3 classes -->
  <line class="line" x1="380" y1="1015" x2="200" y2="1055" marker-end="url(#arrow)"/>
  <line class="line" x1="500" y1="1015" x2="500" y2="1055" marker-end="url(#arrow)"/>
  <line class="line" x1="620" y1="1015" x2="800" y2="1055" marker-end="url(#arrow)"/>

  <!-- Class 1 -->
  <rect class="box-bold" x="80" y="1055" width="240" height="85" rx="4"/>
  <text class="text-title" x="200" y="1080">Understood</text>
  <line class="line" x1="100" y1="1090" x2="300" y2="1090"/>
  <text class="text-sub" x="200" y="1110">Accurate Syntax &amp; Execution</text>
  <text class="text-sub" x="200" y="1127">Coherent Oral State Defense</text>

  <!-- Class 2 -->
  <rect class="box-bold" x="380" y="1055" width="240" height="85" rx="4"/>
  <text class="text-title" x="500" y="1080">Partial Understanding</text>
  <line class="line" x1="400" y1="1090" x2="600" y2="1090"/>
  <text class="text-sub" x="500" y="1110">Working Code with Fragile Logic</text>
  <text class="text-sub" x="500" y="1127">Boundary / Edge-Case Uncertainty</text>

  <!-- Class 3 -->
  <rect class="box-bold" x="680" y="1055" width="240" height="85" rx="4"/>
  <text class="text-title" x="800" y="1080">Possible Misconception</text>
  <line class="line" x1="700" y1="1090" x2="900" y2="1090"/>
  <text class="text-sub" x="800" y="1110">Verified Contradictions</text>
  <text class="text-sub" x="800" y="1127">Verbal Claims Clashing with Traces</text>

  <!-- ==================== STAGE 6: TESTING & VALIDATION PROTOCOL ==================== -->
  <rect class="stage-box" x="40" y="1180" width="920" height="175" rx="6"/>
  <text class="text-stage" x="55" y="1200">PHASE 6: VALIDATION &amp; TESTING PROTOCOL</text>

  <!-- Left: Held-Out Test Set -->
  <rect class="box" x="70" y="1215" width="400" height="120" rx="4"/>
  <text class="text-title" x="270" y="1240">Held-Out Test Set Evaluation (N = 627)</text>
  <line class="line" x1="90" y1="1250" x2="450" y2="1250"/>
  <text class="text-body" x="270" y="1272">• Accuracy: 90.75% | Error Rate: 9.25%</text>
  <text class="text-body" x="270" y="1292">• Macro Precision: 85.82% | Macro Recall: 92.27%</text>
  <text class="text-body" x="270" y="1312">• Macro Specificity: 95.63% | Macro F1: 0.8850 | AUROC: 0.9888</text>

  <!-- Right: 5-Fold Group CV -->
  <rect class="box" x="530" y="1215" width="400" height="120" rx="4"/>
  <text class="text-title" x="730" y="1240">5-Fold Stratified Group Cross-Validation (N = 3,137)</text>
  <line class="line" x1="550" y1="1250" x2="910" y2="1250"/>
  <text class="text-body" x="730" y="1272">• 46 Independent Scenario Families (Zero Leakage)</text>
  <text class="text-body" x="730" y="1292">• Mean Accuracy: 87.23% &plusmn; 4.12%</text>
  <text class="text-body" x="730" y="1312">• Mean Macro F1: 0.8284 &plusmn; 0.0336 | Mean Error: 12.77% &plusmn; 4.12%</text>

</svg>
