# DeepMisconception Environment Configuration

# Backend Settings
DEBUG=false
APP_NAME=DeepMisconception API
APP_VERSION=1.0.0
# Database (auto-resolved to backend/deepmisconception.db if unset)
# DATABASE_URL=sqlite:///./deepmisconception.db

# LLM Provider Configuration
# Set your Gemini API key (recommended: gemini-3.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Provider options: 'auto' (uses Gemini if key present, else mock), 'gemini', 'mock'
LLM_PROVIDER=auto

# Code Execution Sandbox Settings
EXECUTION_TIMEOUT_SECONDS=3.0
EXECUTION_MAX_MEMORY_MB=128
SAFE_SANDBOX_ENABLED=true

# Frontend Configuration
VITE_API_URL=http://localhost:8000
