{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeepMisconceptionProcessFeaturesSchema",
  "description": "Schema for the Exact 24 Numerical Process Features derived from events",
  "type": "object",
  "required": [
    "session_id",
    "n_events",
    "duration_s",
    "n_insert",
    "n_edit",
    "n_delete",
    "n_paste",
    "typed_chars",
    "paste_chars",
    "paste_char_ratio",
    "largest_insert_share",
    "n_runs",
    "n_syntax_errors",
    "n_runtime_errors",
    "n_errors",
    "n_debug_actions",
    "n_tests",
    "n_test_pass",
    "n_revisions",
    "n_errors_resolved",
    "idle_total_s",
    "max_idle_s",
    "mean_gap_s",
    "time_to_first_run_s",
    "final_state_pass"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^DM_[0-9]{4,6}$",
      "description": "Identifier linking to the parent session"
    },
    "n_events": { "type": "integer", "minimum": 0 },
    "duration_s": { "type": "number", "minimum": 0.0 },
    "n_insert": { "type": "integer", "minimum": 0 },
    "n_edit": { "type": "integer", "minimum": 0 },
    "n_delete": { "type": "integer", "minimum": 0 },
    "n_paste": { "type": "integer", "minimum": 0 },
    "typed_chars": { "type": "integer", "minimum": 0 },
    "paste_chars": { "type": "integer", "minimum": 0 },
    "paste_char_ratio": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "largest_insert_share": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "n_runs": { "type": "integer", "minimum": 0 },
    "n_syntax_errors": { "type": "integer", "minimum": 0 },
    "n_runtime_errors": { "type": "integer", "minimum": 0 },
    "n_errors": { "type": "integer", "minimum": 0 },
    "n_debug_actions": { "type": "integer", "minimum": 0 },
    "n_tests": { "type": "integer", "minimum": 0 },
    "n_test_pass": { "type": "integer", "minimum": 0 },
    "n_revisions": { "type": "integer", "minimum": 0 },
    "n_errors_resolved": { "type": "integer", "minimum": 0 },
    "idle_total_s": { "type": "number", "minimum": 0.0 },
    "max_idle_s": { "type": "number", "minimum": 0.0 },
    "mean_gap_s": { "type": "number", "minimum": 0.0 },
    "time_to_first_run_s": { "type": "number", "minimum": 0.0 },
    "final_state_pass": { "type": "integer", "enum": [0, 1] }
  }
}
